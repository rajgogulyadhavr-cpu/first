# GEMINI_API_KEY: Required for all AI features (DFU prediction, chatbot, voice).
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PORT: Server port (default: 3000)
PORT=3000

# FRONTEND_URL: Production frontend URL for CORS (optional, auto-allows *.netlify.app)
# FRONTEND_URL=https://your-app.netlify.app

# VITE_API_BASE_URL: Used in frontend build to point to the production backend.
# Set this in Netlify environment variables, NOT here.
# VITE_API_BASE_URL=https://your-backend.onrender.com
